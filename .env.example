# Port the HTTP server listens on
PORT=3001
# Comma separated origins allowed to call the REST API (bill-please web)
CORS_ORIGINS=http://localhost:3000
# Maximum accepted receipt image size in bytes (default 5 MB)
MAX_IMAGE_BYTES=5242880
# Requests per minute per client IP
RATE_LIMIT_PER_MINUTE=30
# Read client IP from X-Forwarded-For (enable only behind a reverse proxy)
TRUST_PROXY=false
# bill-please-ocr base URL and timeout
OCR_URL=http://localhost:8000
OCR_TIMEOUT_MS=20000
# Skip the LLM and answer 422 when the mean OCR confidence is lower than this
OCR_MIN_CONFIDENCE=0.6
# OpenAI compatible API (llama.cpp llm-server), model name and timeout
LLM_URL=http://localhost:8080/v1
LLM_MODEL=qwen3-4b-instruct-2507
LLM_TIMEOUT_MS=45000
# Bearer token, only for APIs that need one
LLM_API_KEY=
# reasoning_effort sent to the LLM. none turns thinking off. Leave empty to omit the field
LLM_REASONING_EFFORT=none
# Log level: TRACE, DEBUG, INFO, WARN, ERROR or OFF
LOG_LEVEL=INFO
